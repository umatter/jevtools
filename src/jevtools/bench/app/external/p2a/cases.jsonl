{"id": "p2a-01", "messages": "Give me an overview of the wages data", "context": "context.json", "catalog": "catalog.json", "gold": {"outcomes_ok": ["execute", "confirm"], "tool": "describe_dataset", "args": {"dataset": "wages"}}, "tags": ["data"]}
